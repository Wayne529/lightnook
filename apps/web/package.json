{
  "name": "@lightnook/web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "dev:offline": "vite --host 127.0.0.1 --mode offline",
    "build:offline": "tsc --noEmit && vite build --mode offline --outDir dist-offline"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router-dom": "7.18.6",
    "@tanstack/react-query": "5.108.2",
    "react-hook-form": "7.92.0",
    "@hookform/resolvers": "^5.2.2",
    "zod": "4.6.7",
    "lucide-react": "1.77.0"
  },
  "devDependencies": {
    "vite": "8.3.8",
    "@vitejs/plugin-react": "6.3.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0"
  }
}
